PRIVATE_AI_URL=http://localhost:11434
AI_MODEL_NAME=llama3.1

# ---------------------------------------------------------------------------
# Optional settings (safe defaults are used when unset). Server-side only.
# ---------------------------------------------------------------------------
# Use whichever model you have installed (`ollama list`), e.g. qwen3.5:4b
# AI_MODEL_NAME=qwen3.5:4b

# Largest context window ever requested from the model. Each request asks only
# for what it needs; lower this on computers with little memory.
# AI_MAX_CONTEXT=32768
# Upper limit on tokens written per request.
# AI_NUM_PREDICT=8192
# AI_TEMPERATURE=0.3
# How long Ollama keeps the model loaded between requests.
# AI_KEEP_ALIVE=30m
# Hard ceiling for a single model call, in milliseconds (default 15 min).
# AI_REQUEST_TIMEOUT_MS=900000
# Bearer token, if the AI server sits behind an authenticating reverse proxy.
# PRIVATE_AI_API_KEY=

# Where the database file is stored (default: ./data).
# DATA_DIR=./data
# Set to false to stop new people creating accounts.
# ALLOW_SIGNUPS=true
# Set to true when the app is served over HTTPS without a proxy that sends X-Forwarded-Proto.
# SECURE_COOKIES=false

# Largest material accepted per project, in words.
# MAX_SOURCE_WORDS=120000
# Per-user limit on new generations: RATE_LIMIT_MAX per RATE_LIMIT_WINDOW_MS (0 disables).
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=3600000
