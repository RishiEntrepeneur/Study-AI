PRIVATE_AI_URL=http://localhost:11434
AI_MODEL_NAME=llama3.1

# ---------------------------------------------------------------------------
# Optional tuning (server-side only; safe defaults are used when unset)
# ---------------------------------------------------------------------------
# Bearer token, if your AI server sits behind an authenticating reverse proxy.
# PRIVATE_AI_API_KEY=
# Minimum context window requested from Ollama (num_ctx). It is raised
# automatically per request when a chunk needs more, up to 131072.
# AI_NUM_CTX=32768
# Maximum tokens generated per request (num_predict).
# AI_NUM_PREDICT=8192
# AI_TEMPERATURE=0.3
# How long Ollama keeps the model loaded between requests.
# AI_KEEP_ALIVE=30m
# Hard ceiling for a single model call, in milliseconds (default 15 min).
# AI_REQUEST_TIMEOUT_MS=900000
# Largest accepted input, in words.
# MAX_SOURCE_WORDS=120000
# Per-IP rate limit: RATE_LIMIT_MAX generations per RATE_LIMIT_WINDOW_MS (0 disables).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=3600000
